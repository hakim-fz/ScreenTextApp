<?xml version="1.0" encoding="utf-8"?>
<!-- Layar fullscreen untuk memilih area crop dari screenshot -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Screenshot sebagai background penuh -->
    <ImageView
        android:id="@+id/ivScreenshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Screenshot"/>

    <!-- Overlay CropView untuk seleksi area -->
    <com.example.screentextapp.CropView
        android:id="@+id/cropView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Panel instruksi dan tombol di bawah layar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="16dp">

        <!-- Instruksi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="✦ Seret untuk memilih area teks yang ingin di-scan"
            android:textSize="13sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- Tombol aksi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCrop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="✕ Batal"
                android:textColor="#FFFFFF"
                android:strokeColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmCrop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="🔍 Scan Teks Area Ini"
                android:backgroundTint="#1976D2"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
