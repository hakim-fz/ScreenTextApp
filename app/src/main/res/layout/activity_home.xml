<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1976D2"
            app:title="ScreenText"
            app:titleTextColor="#FFFFFF"
            app:subtitleTextColor="#B3E5FC"/>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Layanan ScreenText"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tekan tombol untuk mengaktifkan\nlayanan di latar belakang"
            android:textSize="13sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="36dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulai"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:text="MULAI"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="90dp"
            android:backgroundTint="#1976D2"
            app:elevation="8dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Tidak Aktif"
            android:textSize="13sp"
            android:textColor="#F44336"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tekan lama tombol untuk petunjuk"
            android:textSize="11sp"
            android:textColor="#BDBDBD"
            android:layout_marginTop="8dp"/>

        <!-- Divider -->
        <View
            android:layout_width="200dp"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"/>

        <!-- Tombol fitur Scan Teks -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanTeks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍  Scan Teks dari Gambar"
            android:textSize="14sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:backgroundTint="#388E3C"
            app:cornerRadius="24dp"
            app:elevation="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ambil teks dari foto atau gambar"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Menu"
        app:backgroundTint="#1976D2"
        app:tint="#FFFFFF"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
