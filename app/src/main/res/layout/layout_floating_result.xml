<?xml version="1.0" encoding="utf-8"?>
<!-- Popup hasil scan teks yang muncul sebagai overlay -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F2212121"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 Hasil Scan"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#42A5F5"/>

        <TextView
            android:id="@+id/tvFloatingCharCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#9E9E9E"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444"
        android:layout_marginBottom="8dp"/>

    <!-- Area teks hasil (scrollable, max 4 baris tampil) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="140dp">

        <TextView
            android:id="@+id/tvFloatingResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:padding="4dp"
            android:lineSpacingMultiplier="1.3"
            android:textIsSelectable="true"/>

    </ScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Tombol aksi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFloatingSalin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="📋 Salin"
            android:textSize="13sp"
            android:backgroundTint="#388E3C"
            app:cornerRadius="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFloatingBagikan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="↗ Bagikan"
            android:textSize="13sp"
            android:backgroundTint="#F57C00"
            app:cornerRadius="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFloatingTutup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✕ Tutup"
            android:textSize="13sp"
            android:backgroundTint="#616161"
            app:cornerRadius="6dp"/>

    </LinearLayout>

</LinearLayout>
